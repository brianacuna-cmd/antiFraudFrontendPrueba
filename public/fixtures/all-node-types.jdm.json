{
  "contentType": "application/vnd.gorules.decision",
  "nodes": [
    {
      "id": "request",
      "type": "inputNode",
      "name": "Request",
      "position": { "x": 40, "y": 200 }
    },
    {
      "id": "route",
      "type": "switchNode",
      "name": "Route",
      "position": { "x": 280, "y": 200 },
      "content": {
        "hitPolicy": "first",
        "statements": [
          {
            "id": "s-charge",
            "condition": "providerEventType == \"CHARGEBACK\"",
            "isDefault": false
          },
          {
            "id": "s-default",
            "condition": "",
            "isDefault": true
          }
        ]
      }
    },
    {
      "id": "charge",
      "type": "expressionNode",
      "name": "ChargebackScore",
      "position": { "x": 560, "y": 80 },
      "content": {
        "expressions": [{ "id": "e-charge", "key": "riskScore", "value": "80" }]
      }
    },
    {
      "id": "table",
      "type": "decisionTableNode",
      "name": "FirstHit",
      "position": { "x": 560, "y": 280 },
      "content": {
        "hitPolicy": "first",
        "inputs": [{ "id": "i1", "name": "Amount", "field": "amountCents" }],
        "outputs": [{ "id": "o1", "name": "Score", "field": "riskScore" }],
        "rules": [{ "_id": "r1", "i1": ">= 1", "o1": "15" }]
      }
    },
    {
      "id": "fn",
      "type": "functionNode",
      "name": "PassScore",
      "position": { "x": 840, "y": 280 },
      "content": {
        "source": "export const handler = (input) => ({ riskScore: Number(input.riskScore) })"
      }
    },
    {
      "id": "response",
      "type": "outputNode",
      "name": "Response",
      "position": { "x": 1080, "y": 180 }
    }
  ],
  "edges": [
    { "id": "e1", "sourceId": "request", "targetId": "route" },
    { "id": "e2", "sourceId": "route", "targetId": "charge", "sourceHandle": "s-charge" },
    { "id": "e3", "sourceId": "route", "targetId": "table", "sourceHandle": "s-default" },
    { "id": "e4", "sourceId": "charge", "targetId": "response" },
    { "id": "e5", "sourceId": "table", "targetId": "fn" },
    { "id": "e6", "sourceId": "fn", "targetId": "response" }
  ]
}
